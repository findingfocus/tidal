d2 $ every 4 (density 2) $ sound "bass1(3,8)" # gain "1" # cutoff "800" 

d2 silence

d1 $ s "<clap>" # gain "0.5" # cutoff "800"

d3 $ s "hh hh [hh hh] bd" # gain "0.5"

d4 $ fast 2 $ n "{0 3 5 <7 <~ 12 15 10>>}%8" # sound "superfm" # gain "0.4"

d4 silence

d5 $ struct "1(<3>,8)"
$ n "0"
# sound "superpiano"
+ up "<0 3 -4 -2>"
# gain "0.6"
# cutoff "800"

d6 $ fast 2 $ stack [
  struct "11" $ sound "bd",
  struct "0101" $ sound "sn"
] # gain "0.3"

hush

d1 $ jux rev $ slow 4 $ n (off "q" (|+ "<-7 5>")
  $ off "e" (|+ 12) $ "c3(2,4) c4(8, 16) d4 e3(3,8)") # s "superhammond"
  # legato 1
# room 0.4 # sz 0.9 # gain 0.8

d2 $ sound "~ bd*2 bd clap:4" # delay 0.4
# delayt (1/6) # delayfb 0.4 # lock 1 # lpf 1300

d3 $ splice 8 "<0 3 2> " $ sound "break"

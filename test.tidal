d2 $ every 4 (density 2) $ sound "bass1(3,8)" # gain "1" # cutoff "800" 

d2 silence

d1 $ s "<clap>" # gain "0.5" # cutoff "800"

d3 $ s "hh hh [hh hh] bd" # gain "0.5"

d4 $ fast 2 $ n "{0 3 5 <7 <~ 12 15 10>>}%8" # sound "superfm" # gain "0.4"

d4 silence

d5 $ struct "1(<3>,8)"
$ n "0"
# sound "superpiano"
+ up "<0 3 -4 -2>"
# gain "0.6"
# cutoff "800"

d6 $ fast 2 $ stack [
  struct "11" $ sound "bd",
  struct "0101" $ sound "sn"
] # gain "0.3"

hush
